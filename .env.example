# ==============================================================
#  Konfigurasi Environment SIDUK
#  1) Salin file ini menjadi .env  ->  cp .env.example .env
#  2) Isi sesuai kondisi server Anda.
#  Catatan: file .env TIDAK BOLEH di-commit ke repository.
# ==============================================================

# --- Database (MySQL / MariaDB) ---
DB_HOST=localhost
DB_USER=root
DB_PASS=
DB_NAME=siduk

# --- Nama/URL dasar aplikasi (opsional, untuk link email konfirmasi) ---
# APP_URL=https://siduk.domainanda.go.id

# --- Email (PHPMailer). Bisa juga diatur lewat Dashboard > Pengaturan Aplikasi ---
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# MAIL_FROM=
# MAIL_FROM_NAME=Dinas Kependudukan dan Pencatatan Sipil
